#!/bin/bash

# Set errexit to exit immediately if a command exits with a non-zero status
set -o errexit

# Set pipefail to cause a pipeline to return a failure status if any command in the pipeline fails
set -o pipefail

# Set nounset to exit if an unset variable is referenced
set -o nounset


# Apply migrations to the database using Django's manage.py script
python manage.py makemigrations
python manage.py migrate


# Aggiunge i nuovi dati di riferimento (tipi documento, requisiti/servizi e
# i set che li raggruppano per categoria fornitore) introdotti dal codice
# appena deployato, usati dai menu a tendina di admin/portale. --create-only
# crea solo ciò che manca e non tocca righe/set già esistenti (potrebbero
# essere stati personalizzati da admin: nome, descrizione, lista
# documenti/requisiti collegati). Ordine come da
# docs/PROJECT_OVERVIEW_AND_LOCAL_SETUP.md §9 (alcuni seedano righe di
# catalogo che altri collegano insieme). `populate_competences` è escluso:
# usa una codifica diversa da quella già a catalogo e duplicherebbe
# requisiti esistenti — richiede un intervento dedicato, non automatico.
python manage.py populate_document_types --create-only
python manage.py seed_competence_sets --create-only
python manage.py seed_service_sets --create-only
python manage.py seed_document_sets --create-only


# Execute Django's development server with Werkzeug debugger enabled
# Listening on all interfaces (0.0.0.0) on port 8000
exec python manage.py runserver_plus 0.0.0.0:8000
