# Variabili email - da copiare in .envs/.django.env (Docker) o nel
# .env della VM. Solo placeholder: mai valori reali in questo file.
#
# Test/Prod (stesso schema di FApp): l'app invia in SMTP a localhost:25, dove il
# Postfix della VM fa da relay autenticato verso Exchange Online. Le credenziali
# stanno solo nel Postfix: EMAIL_HOST_USER/EMAIL_HOST_PASSWORD restano vuote.
# DEFAULT_FROM_EMAIL deve essere la casella con cui si autentica il relay o una
# casella su cui questa ha il permesso "Send As", altrimenti Exchange rifiuta
# l'invio (554 SendAsDenied). Scelta per SRM: casella condivisa
# albo.fornitori@fulgard.com (vedi docs/PROJECT_OVERVIEW_AND_LOCAL_SETUP.md,
# §8 A8). Dopo una modifica va riavviato il servizio dell'app.
#
# Locale (Docker): EMAIL_HOST=mailpit, EMAIL_PORT=1025 -> le email si leggono
# su http://localhost:8025, nessun invio reale.

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=albo.fornitori@fulgard.com

# Se valorizzato (lista separata da virgole) TUTTE le email vengono dirottate
# a questi indirizzi invece che ai destinatari reali. Vuoto in prod.
EMAIL_REDIRECT_TO=

# Validità dei link: invito al portale (giorni) e reset password (ore)
PORTAL_INVITE_TIMEOUT_DAYS=3
PASSWORD_RESET_TIMEOUT_HOURS=24

# URL pubblico del portale, senza "/" finale: serve per il link al portale
# nelle email inviate dal job Celery dei promemoria scadenze (fuori da una
# richiesta HTTP). Se vuoto l'email parte comunque, ma senza link.
PORTAL_BASE_URL=https://portale.example.invalid
