# FABRIC_HUB (API DAB) - ricerca fornitori nel form fornitore.
# Copiare in .envs/.fabrichub.env (locale) o nel .env della VM; mai committare valori reali.
FABRICHUB_TENANT_ID=
FABRICHUB_CLIENT_ID=
FABRICHUB_CLIENT_SECRET=
FABRICHUB_SCOPE=api://<client_id>/.default
# Opzionali (valori di default mostrati)
# FABRICHUB_BASE_URL=https://fulgardas.fulgard.com
# FABRICHUB_API_ROLE=Reader
# FABRICHUB_SUPPLIERS_ENTITY=Fornitori_CF
# FABRICHUB_CACHE_SECONDS=600
